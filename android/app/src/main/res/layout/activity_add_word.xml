<?xml version="1.0" encoding="utf-8"?>
<!-- Шит «добавить слово» (PROCESS_TEXT). Никакого WebView: активити должна появляться
     мгновенно поверх чужого приложения, 1.5–2 с холодного старта тут неприемлемы. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/norsk_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/norsk_scrim">

    <LinearLayout
        android:id="@+id/norsk_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/norsk_sheet_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/norsk_grabber" />

        <TextView
            android:id="@+id/norsk_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/norsk_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/norsk_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/norsk_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/norsk_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/norsk_text_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/norsk_alternatives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/norsk_other_word"
            android:textColor="@color/norsk_accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/norsk_sets"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/norsk_field_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <TextView
            android:id="@+id/norsk_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/norsk_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/norsk_cancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:text="@string/norsk_cancel"
                android:textAllCaps="false"
                android:textColor="@color/norsk_text_muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/norsk_primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/norsk_btn_primary"
                android:text="@string/norsk_add"
                android:textAllCaps="false"
                android:textColor="@color/norsk_on_accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

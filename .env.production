# Прод-сборка (Vercel). URL бэкенда на Fly.io.
VITE_API_URL=https://api.learnnorsk.space
# Google OAuth Web Client ID (публичный, не секрет — виден в бандле клиента).
VITE_GOOGLE_CLIENT_ID=296014238677-a9281g65p8i6crrp6u3hr3ufgirf6t1r.apps.googleusercontent.com
# Обновления APK (в вебе не используются). OTA — веб-часть с прода (scripts/ota-bundle.mjs кладёт
# её при каждом деплое Vercel); APK — app.json последнего GitHub-релиза (scripts/release-apk.sh).
VITE_OTA_MANIFEST=https://learnnorsk.vercel.app/ota/latest.json
VITE_APK_MANIFEST=https://github.com/Noxam98/learnNorskApp/releases/latest/download/app.json
